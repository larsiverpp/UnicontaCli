<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Base.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SolutionDir>$(MSBuildProjectDirectory)\..</SolutionDir>
    <SolutionFile Condition="'$(SolutionFile)' == ''">$(SolutionDir)\$(SolutionName).slnx</SolutionFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ReportGenerator" />
  </ItemGroup>
  <Target Name="_Restore">
    <MSBuild Projects="$(SolutionFile);$(MSBuildThisFileFullPath)" Targets="restore" BuildInParallel="true" />
  </Target>
  <Target Name="_Build">
    <MakeDir Directories="$(ArtifactDirectory)" />
    <MSBuild Projects="$(SolutionFile)" Targets="build;publish" Properties="Configuration=$(Configuration);NoRestore=true" BuildInParallel="true" />
    <CallTarget Targets="CopyDeploymentFiles" />
  </Target>
  <Target Name="_Test">
    <PropertyGroup>
      <TestResultsDirectory>$(MSBuildProjectDirectory)\obj\TestResults</TestResultsDirectory>
      <TestReportDirectory>$(MSBuildProjectDirectory)\obj\TestReport</TestReportDirectory>
      <TestArguments Condition="'$(RunAllTests)' == 'true'">$(TestArguments) -p:RunAllTests=true</TestArguments>
      <TestCoverageArguments Condition="'$(IncludeTestCoverage)' == 'true'"> --coverage --coverage-output-format cobertura</TestCoverageArguments>
    </PropertyGroup>
    <RemoveDir Directories="$(TestResultsDirectory);$(TestReportDirectory)" />
    <Exec Command="dotnet test $(SolutionFile) -c $(Configuration) --no-restore --no-build --results-directory $(TestResultsDirectory) $(TestArguments) -- --report-trx $(TestCoverageArguments)" />
    <ItemGroup>
      <CoverageFile Include="$(TestResultsDirectory)\*.cobertura.xml" />
      <CoverageReport Include="Cobertura;MarkdownAssembliesSummary" />
      <CoverageReport Condition="'$(IncludeTestCoverageHtml)' == 'true'" Include="Html" />
    </ItemGroup>
    <ReportGenerator Condition="'$(IncludeTestCoverage)' == 'true'" ReportFiles="@(CoverageFile)" TargetDirectory="$(TestReportDirectory)" ReportTypes="@(CoverageReport)" />
  </Target>
  <Target Name="_Clean">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\bin;$(MSBuildProjectDirectory)\obj" ContinueOnError="true" />
    <MSBuild Projects="$(SolutionFile)" Targets="clean" Properties="Configuration=$(Configuration);CleanBinObj=true;NoRestore=true" BuildInParallel="true" ContinueOnError="true" />
  </Target>
  <Import Project="Base.targets" />
</Project>